<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs JIT and unsigned executable memory under the
       hardened runtime, or the app will not launch once signed. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Overgit shells out to git, gh, glab, claude, codex and gemini from
       the user's PATH (often /opt/homebrew/bin). Inheriting that environment
       and loading those binaries' libraries needs these two. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Listing repos from the GitHub, GitLab and Bitbucket APIs when cloning. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Repos are picked with the open dialog and then read and written in
       place. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
